{
  "name": "vamos-a-padel-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot that auto-books padel courts at Enjoy Valencia (ReservaPlay)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env --disable-warning=ExperimentalWarning dist/src/index.js",
    "cli": "node --env-file=.env --disable-warning=ExperimentalWarning dist/src/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "luxon": "^3.5.0",
    "pino": "^10.4.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
