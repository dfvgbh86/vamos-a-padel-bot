# Copy to .env and fill in yourself. Never commit .env, never paste these values into chats.

# Telegram bot (create with @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id(s) allowed to use the bot, comma-separated (get it from @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=

# ReservaPlay account (enjoyvalenciaclubesoutdoor.reservaplay.com)
RESERVAPLAY_BASE_URL=https://enjoyvalenciaclubesoutdoor.reservaplay.com
RESERVAPLAY_USERNAME=
RESERVAPLAY_PASSWORD=

# Optional: extra dates (YYYY-MM-DD, comma-separated) treated as holidays = no academy, all courts allowed.
# The official Valencia holidays for 2026-2027 are already built in (src/config/holidays.ts); leave empty
# unless you know about one that is missing (e.g. a 2027 local holiday once it is published).
EXTRA_HOLIDAYS=
